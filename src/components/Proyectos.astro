---
import "../styles/proyectos.css";
const projects = [
	{
		status: "PRODUCCIÓN",
		title: "Expo & Summit Digital Backbone",
		repo: "astro-backbone / expo-digital-platform",
		description:
			"Plataforma integral de agendas dinámicas, mapas interactivos de stands y acreditaciones en tiempo real para exposiciones multitudinarias de gran concurrencia (como Expo Killa y congresos tecnológicos).",
		tags: ["Astro", "TypeScript", "TailwindCSS", "PWA Offline"],
		stars: "142",
		forks: "38",
		version: "v1.4.1",
		icon: "▦",
	},
	{
		status: "ACTIVE COMMUNITY",
		title: "Killa UI: Astro Cyber Theme",
		repo: "killa-ui / astro-cyber-theme",
		description:
			"Starter kit y sistema de diseño completo para landing pages y dashboards con estética glassmorphic especial, microanimaciones CSS fluidas y publicación 100% en GitHub.",
		tags: ["Astro v4", "Tailwind 3.4", "Web Components"],
		stars: "328",
		forks: "84",
		version: "v1.0.8",
		icon: "▧",
	},
	{
		status: "ACTIVE ENGINE",
		title: "Killa Edge Telemetry Daemon",
		repo: "killa-tech / edge-telemetry",
		description:
			"Daemon ligero escrito en Rust para recolección de métricas edge, sincronización de base de datos en nodos distribuidos y transmisión cifrada con bajo consumo energético.",
		tags: ["Rust", "Tokio Async", "eBPF", "Dockerized"],
		stars: "95",
		forks: "12",
		version: "v0.9.4",
		icon: "▤",
	},
	{
		status: "STABLE",
		title: "Quantum Auth & Session Gateway",
		repo: "killa-tech / auth-session",
		description:
			"Módulo de autenticación descentralizada con soporte Passkeys/WebAuthn, tokens criptográficos rotativos e integración para arquitecturas multi-tenant sin dependencias pesadas.",
		tags: ["Node / Rust", "WebAuthn", "PostgreSQL", "Zero-Trust"],
		stars: "210",
		forks: "49",
		version: "v1.1.0",
		icon: "♙",
	},
];
const mobileRepos = [
	{
		name: "killa-core-engine",
		description: "Motor de procesamiento lunar para telemetría espacial distribuida sobre WebAssembly y Rust.",
		language: "Rust",
		metadata: "passing v2.1",
		stars: "482",
	},
	{
		name: "astro-lunar-theme",
		description: "Starter kit de Astro 4 con diseño Cyber Lunar, tokens semánticos de Tailwind y soporte PWA integrado.",
		language: "TypeScript",
		metadata: "Astro v4",
		stars: "1.2k",
	},
	{
		name: "killa-edge-gateway",
		description: "Gateway ultra ligero para enrutamiento inteligente y balanceo de carga en nodos descentralizados.",
		language: "Go",
		metadata: "dockerized",
		stars: "319",
	},
];
---

<section class="projects-section section-shell" id="proyectos">
				<div class="project-section-heading project-heading-row">
					<div>
						<h2>Proyectos realizados</h2>
					</div>
				</div>
				<div class="project-grid">
					{projects.map((project) => (
						<article class="project-card">
							<div class="project-top"><span class="project-status">● {project.status}</span><span>{project.version}</span></div>
							<div class="project-title-row"><div><h3>{project.title}</h3><span class="project-repo-path">{project.repo}</span></div><span class="project-icon">{project.icon}</span></div>
							<p class="project-description">{project.description}</p>
							<div class="tag-list">{project.tags.map((tag) => <span>{tag}</span>)}</div>
							<div class="project-bottom"><span>☆ {project.stars} &nbsp;⑂ {project.forks}</span><a href="https://github.com/Killa-Tech">VER REPO ↗</a></div>
						</article>
					))}
				</div>
				<div class="project-mobile-repositories">
					<div class="projects-mobile-heading">
						<h2>▏PROYECTOS REALIZADOS</h2>
					</div>
					{mobileRepos.map((repo) => (
						<a class="mobile-repo-card" href="https://github.com/Killa-Tech">
							<div class="mobile-repo-title"><span>▰ {repo.name}</span><span>☆ {repo.stars}</span></div>
							<span class="project-repo-path">killatech / {repo.name}</span>
							<p>{repo.description}</p>
							<div class="mobile-repo-meta"><span>● {repo.language}</span><span>{repo.metadata}</span><b>↗</b></div>
						</a>
					))}
				</div>
			</section>
