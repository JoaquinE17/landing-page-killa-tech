---
import "../styles/filosofia.css";
const pillars = [
	{
		icon: "◈",
		title: "Ingeniería de Precisión",
		description:
			"Priorizamos arquitecturas limpias, tipado estricto en tiempo de compilación y cobertura rigurosa de pruebas de extremo a extremo. Cero tolerancia para el código espagueti.",
		tag: "ZERO WASTE FAILURES",
	},
	{
		icon: "✣",
		title: "Open Source & Comunidad",
		description:
			"El conocimiento no se encierra: se propaga. Diseñamos librerías abiertas, plantillas reproducibles y componentes para potenciar a los desarrolladores de toda la región.",
		tag: "GPL-3.0 / MIT",
	},
	{
		icon: "◎",
		title: "Ecosistema Moderno",
		description:
			"Especialistas en la trinidad moderna de rendimiento: Astro para rendering estático/híbrido, Rust para computación nativa y contenedores desacoplados.",
		tag: "LÍMITES ARQUITECTÓNICOS CLAROS",
	},
];
---

<section class="philosophy section-shell" id="filosofia">
				<div class="philosophy-heading philosophy-intro">
					<h2>Nuestra Filosofía: <span>Killa</span> es Luna en Quechua.</h2>
					<p class="section-intro">Inspirados en la sabiduría milenaria andina de observación sideral y armonía natural, fusionada con la computación autónoma y la ingeniería aeroespacial del mañana.</p>
				</div>
				<div class="pillar-grid-desktop">
					{pillars.map((pillar) => (
						<article class="pillar-card-desktop">
							<div class="pillar-icon">{pillar.icon}</div>
							<h3>{pillar.title}</h3>
							<p>{pillar.description}</p>
						</article>
					))}
				</div>
				<div class="philosophy-mobile-intro philosophy-intro">
					<div class="philosophy-mobile-heading">
						<h2>▏NUESTRA FILOSOFIA:</h2>
					</div>
					<p class="section-intro">Inspirados en la sabiduría milenaria andina de observación sideral y armonía natural, fusionada con la computación autónoma y la ingeniería aeroespacial del mañana.</p>
				</div>
				<div class="pillar-grid-mobile">
					{pillars.map((pillar) => (
						<article class="pillar-card-mobile">
							<div class="pillar-icon">{pillar.icon}</div>
							<h3>{pillar.title}</h3>
							<p>{pillar.description}</p>
						</article>
					))}
				</div> 
			</section>
